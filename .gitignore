# Фотографии и скриншоты, присланные Маргаритой, — рабочие референсы.
# Код на них не ссылается, обводки с них уже сняты в src/data/squidArt.js
# и squidParts.js. 14 МБ HEIC и PNG в репозитории не нужны.
/fresh/

# Исходники фотографий работ (HEIC и PNG с телефона, 115 МБ на троих).
# Готовые снимки лежат в public/art/{squids,dolls,portraits} — как они
# собираются, написано в комментарии к src/data/gallery.js.
# portrsits — так папка названа у Маргариты, с опечаткой.
# Слеш в начале обязателен: без него «dolls/» ловил ещё и
# public/art/dolls, и готовые снимки не попадали в репозиторий.
/squidy/
/dolls/
/portrsits/
